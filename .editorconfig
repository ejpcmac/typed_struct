# SPDX-FileCopyrightText: NONE
# SPDX-License-Identifier: CC0-1.0

# EditorConfig is awesome: http://EditorConfig.org

root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
max_line_length = 80
trim_trailing_whitespace = true
insert_final_newline = true

[*.{json,md,sh,toml}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[README.md]
# NOTE: The README.md contains Elixir examples, which are indented by two
# spaces. We need to reduce the indent size here to avoid any linting issue.
indent_size = 2
# NOTE: The README.md contains some URLs being too long to fit on 80-character
# lines.
max_line_length = 140

[CHANGELOG.md]
# NOTE: The README.md contains some URLs being too long to fit on 80-character
# lines.
max_line_length = 100

[flake.nix]
# NOTE: The copyright line is 82-character-long and cannot be split.
max_line_length = 82

[ci.yml]
# NOTE: The copyright line is 88-character-long and cannot be split.
max_line_length = 88
